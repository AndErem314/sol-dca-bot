{
  "name": "sol-dca-bot",
  "version": "2.0.0",
  "description": "Multi-pair DCA bot for Solana tokens via Jupiter Trigger (limit orders), Phantom wallet. Paper + live modes.",
  "main": "src/bot.js",
  "scripts": {
    "start": "node src/bot.js",
    "start:live": "node src/bot.js --live",
    "test": "node --test \"tests/**/*.test.js\"",
    "check-balance": "node src/utils/checkBalance.js",
    "calculate": "node src/utils/calculateOrders.js",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "keywords": [
    "solana",
    "jupiter",
    "dca",
    "trading-bot",
    "phantom-wallet",
    "crypto",
    "trading"
  ],
  "author": "AndreyE.",
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "^1.95.0",
    "dotenv": "^16.3.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.53.0",
    "prettier": "^3.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}